  "design_constraints": {
    "no_inner_column": "G (left) and M (right) never used for layer content",
    "no_top_row_content": "Top rows empty or ghost on all redesigned layers",
    "no_sideways_movement": "All access keys require straight vertical finger movement only",
    "finger_strength_order": "Strongest finger gets highest-frequency symbol/action",
    "directional_consistency": "NEIO always maps to left/down/up/right across navigation layers"
  },
  "layer_access_keys": {
    "note": "Assigned by usage frequency \u2014 most-used layer gets best access key",
    "usage_priority": [
      "L10 International",
      "L4 Symbols",
      "L5 Numbers"
    ],
    "assignments": [
      {
        "key": "Hold F or Hold U (middle finger up)",
        "layer": "L11",
        "type": "TD_F tap=F hold=MO11 \u00b7 TD_U tap=U hold=MO11",
        "reason": "Tiling WM \u2014 comfortable middle finger stretch"
      },
      {
        "key": "Space (left thumb middle)",
        "layer": "L2",
        "type": "LT2(KC_SPACE)",
        "reason": "Navigation \u2014 most-used layer"
      },
      {
        "key": "Tab (left thumb outer)",
        "layer": "L3",
        "type": "LT3(KC_TAB)",
        "reason": "Mouse \u2014 rarely used"
      },
      {
        "key": "Bsp (right thumb middle)",
        "layer": "L4",
        "type": "LT4(KC_BSPACE)",
        "reason": "Symbols \u2014 2nd most used, easiest right thumb (no lateral)"
      },
      {
        "key": "Ent (right thumb inner)",
        "layer": "L5",
        "type": "LT5(KC_ENTER)",
        "reason": "Numbers \u2014 3rd most used"
      },
      {
        "key": "Del (right thumb outer)",
        "layer": "L6",
        "type": "LT6(KC_DELETE)",
        "reason": "Function keys \u2014 occasional"
      },
      {
        "key": "Z (left pinky bottom)",
        "layer": "L7",
        "type": "TD(0) tap=Z hold=MO7",
        "reason": "Clipboard \u2014 symmetric required"
      },
      {
        "key": "Hold C or Hold , (middle fingers down)",
        "layer": "L8",
        "type": "TD(9) tap=C hold=MO8 \u00b7 TD(10) tap=, hold=MO8",
        "reason": "Brackets \u2014 middle finger strongest symmetric bottom pair"
      },
      {
        "key": "Hold X or Hold . (ring fingers \u2014 symmetric)",
        "layer": "L9",
        "type": "TD(2) tap=X hold=MO9 \u00b7 TD(12) tap=. hold=MO9",
        "reason": "Code & CLI \u2014 now symmetric; ring fingers"
      },
      {
        "key": ", (right middle bottom)",
        "layer": "none",
        "type": "KC_COMMA",
        "reason": "Freed from L9 \u2014 available for future layer"
      },
      {
        "key": "D (left index bottom)",
        "layer": "L10",
        "type": "TD(17) tap=D hold=MO10",
        "reason": "International \u2014 promoted to index, German-primary typist"
      },
      {
        "key": "Hold W (left ring top) or Hold Y (right ring top)",
        "layer": "L1",
        "type": "TD_W tap=W hold=MO1 \u00b7 TD_Y tap=Y hold=MO1",
        "reason": "Ring top row \u2014 both halves accessible, left thumb cluster fully usable"
      }
    ]
  },
